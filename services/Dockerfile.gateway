FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY lib /src/lib
COPY gateway/src /src/gateway/src
RUN mkdir -p /src/out && javac -d /src/out -cp "$(ls /src/lib/*.jar | tr '\n' ':')" $(find /src/gateway/src -name '*.java')

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/out /app/classes
COPY lib /app/lib
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -cp /app/classes:$(ls /app/lib/*.jar | tr '\\n' ':') io.acb.gateway.Gateway"]
