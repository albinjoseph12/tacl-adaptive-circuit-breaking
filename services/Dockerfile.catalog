FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY lib /src/lib
COPY catalog-service/src /src/catalog-service/src
RUN mkdir -p /src/out && javac -d /src/out -cp "$(ls /src/lib/*.jar | tr '\n' ':')" $(find /src/catalog-service/src -name '*.java')

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/out /app/classes
COPY lib /app/lib
EXPOSE 8081 8091
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -cp /app/classes:$(ls /app/lib/*.jar | tr '\\n' ':') io.acb.catalog.CatalogService"]
